# Plantilla de variables de entorno de HARNESS.
#
# Las claves de API se definen solo en variables de entorno: nunca en config.toml, en el código ni
# en este archivo. Aquí están vacías a propósito: es solo una lista de los nombres que se usan.
#
# HARNESS no lee un archivo ".env". Si copia esta plantilla a ".env" (que Git ignora), cárguelo
# usted en su terminal antes de arrancar, o defina las variables directamente:
#
#   PowerShell:   $env:ANTHROPIC_API_KEY = "<su clave>"
#   bash:         export ANTHROPIC_API_KEY="<su clave>"
#
# Solo hace falta la variable del proveedor que indique "model" en config.toml; el proveedor
# simulado (fake/...) no necesita ninguna.

# Clave del proveedor anthropic
ANTHROPIC_API_KEY=

# Clave del proveedor openai
OPENAI_API_KEY=
